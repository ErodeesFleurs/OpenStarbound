{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "CC": "$env{XCLANG_ROOT}/bin/clang",
        "CXX": "$env{XCLANG_ROOT}/bin/clang++",
        "PATH": "$env{XCLANG_ROOT}/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceParentDir}/install",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceParentDir}/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{XCLANG_ROOT}/lib/cmake/xclang/toolchain.cmake",
        "VCPKG_MANIFEST_FEATURES": "qt-tools",
        "CMAKE_VERBOSE_MAKEFILE": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "STAR_BUILD_QT_TOOLS": true,
        "BUILD_TESTING": true,
        "STAR_ENABLE_STEAM_INTEGRATION": true,
        "STAR_ENABLE_DISCORD_INTEGRATION": true
      }
    },
    {
      "inherits": "base",
      "name": "windows-release",
      "displayName": "Windows x64 (xclang 23.1.2.9, MinGW libc++)",
      "binaryDir": "${sourceParentDir}/build/windows-release",
      "environment": {
        "CC": "$env{XCLANG_ROOT}/bin/clang.exe",
        "CXX": "$env{XCLANG_ROOT}/bin/clang++.exe",
        "PATH": "$env{XCLANG_ROOT}/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "XCLANG_TARGET": "x86_64-w64-mingw32",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "CMAKE_INCLUDE_PATH": "${sourceParentDir}/lib/windows/include",
        "CMAKE_LIBRARY_PATH": "${sourceParentDir}/lib/windows",
        "STAR_USE_RPMALLOC": true,
        "STAR_USE_JEMALLOC": false
      }
    },
    {
      "inherits": "windows-release",
      "name": "windows-cross",
      "displayName": "Windows x64 (cross-compile from Linux)",
      "binaryDir": "${sourceParentDir}/build/windows-cross",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "environment": {
        "CC": "$env{XCLANG_ROOT}/bin/clang",
        "CXX": "$env{XCLANG_ROOT}/bin/clang++",
        "PATH": "$env{XCLANG_ROOT}/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_FIND_ROOT_PATH": "${sourceParentDir}/lib/windows",
        "VCPKG_APPLOCAL_DEPS": false,
        "STAR_BUILD_DEV_TOOLS": true
      }
    },
    {
      "inherits": "base",
      "name": "linux-release",
      "displayName": "Linux x64 (xclang 23.1.2.9, libc++)",
      "binaryDir": "${sourceParentDir}/build/linux-release",
      "cacheVariables": {
        "XCLANG_TARGET": "x86_64-unknown-linux-gnu",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_INCLUDE_PATH": "${sourceParentDir}/lib/linux/include",
        "CMAKE_LIBRARY_PATH": "${sourceParentDir}/lib/linux",
        "STAR_USE_JEMALLOC": true
      }
    },
    {
      "inherits": "linux-release",
      "name": "linux-arm-release",
      "displayName": "Linux ARM64 (xclang 23.1.2.9, libc++)",
      "binaryDir": "${sourceParentDir}/build/linux-arm-release",
      "cacheVariables": {
        "XCLANG_TARGET": "aarch64-unknown-linux-gnu",
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "VCPKG_HOST_TRIPLET": "arm64-linux",
        "STAR_ENABLE_STEAM_INTEGRATION": false,
        "STAR_ENABLE_DISCORD_INTEGRATION": false
      }
    },
    {
      "inherits": "base",
      "name": "macos-release",
      "displayName": "macOS x64 (xclang 23.1.2.9, libc++)",
      "binaryDir": "${sourceParentDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XCLANG_TARGET": "x86_64-apple-darwin",
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "VCPKG_HOST_TRIPLET": "x64-osx",
        "CMAKE_INCLUDE_PATH": "${sourceParentDir}/lib/osx/include",
        "CMAKE_LIBRARY_PATH": "${sourceParentDir}/lib/osx/x64;${sourceParentDir}/lib/osx",
        "STAR_USE_JEMALLOC": false,
        "STAR_ENABLE_DISCORD_INTEGRATION": false
      }
    },
    {
      "inherits": "macos-release",
      "name": "macos-arm-release",
      "displayName": "macOS ARM64 (xclang 23.1.2.9, libc++)",
      "binaryDir": "${sourceParentDir}/build/macos-arm-release",
      "cacheVariables": {
        "XCLANG_TARGET": "aarch64-apple-darwin",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "CMAKE_LIBRARY_PATH": "${sourceParentDir}/lib/osx/arm64;${sourceParentDir}/lib/osx"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-cross", "configurePreset": "windows-cross" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-arm-release", "configurePreset": "linux-arm-release" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "macos-arm-release", "configurePreset": "macos-arm-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "NoAssets" } }
    },
    { "inherits": "base", "name": "windows-release", "configurePreset": "windows-release" },
    { "inherits": "base", "name": "windows-cross", "configurePreset": "windows-cross" },
    { "inherits": "base", "name": "linux-release", "configurePreset": "linux-release" },
    { "inherits": "base", "name": "linux-arm-release", "configurePreset": "linux-arm-release" },
    { "inherits": "base", "name": "macos-release", "configurePreset": "macos-release" },
    { "inherits": "base", "name": "macos-arm-release", "configurePreset": "macos-arm-release" }
  ]
}
