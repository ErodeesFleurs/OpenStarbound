{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "glew",
    { "name": "sdl3", "default-features": false, "features": ["wayland", "x11", "alsa", "ibus", "dbus"], "platform": "linux" },
    { "name": "sdl3", "platform": "!linux" },
    { "name": "cpptrace", "platform": "!windows" },
    "libvorbis",
    "zlib-ng",
    "freetype",
    "libpng",
    "opus",
    "zstd",
    "mimalloc",
    { "name": "jemalloc", "platform": "linux" },
    "re2",
    { "name": "imgui", "features": ["sdl3-binding", "opengl3-binding", "freetype"] },
    { "name": "cpr", "version>=": "1.10.5", "features": ["ssl"] }
  ],
  "features": {
    "benchmarks": {
      "description": "Standalone Google Benchmark performance executables",
      "dependencies": [{ "name": "benchmark", "version>=": "1.9.5" }]
    },
    "qt-tools": {
      "description": "Static Qt5 widgets for json_tool and mod_uploader",
      "dependencies": ["qt5-base"]
    }
  }
}
