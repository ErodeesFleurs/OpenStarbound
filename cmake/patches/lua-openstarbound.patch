+/*
+** OpenStarbound's safe navigation preserves a false/nil receiver and
+** skips evaluation of an indexed key on that path.
+*/
+static void safe_navigation (LexState *ls, expdesc *v) {
+  FuncState *fs = ls->fs;
+  expdesc key;
+  int base, jump;
+  luaX_next(ls);  /* skip '?' */
+  luaK_exp2nextreg(fs, v);
+  base = v->u.info;
+  luaK_codeABCk(fs, OP_TEST, base, 0, 0, 0);
+  jump = luaK_jump(fs);
+  switch (ls->t.token) {
+    case '[':
+      yindex(ls, &key);
+      luaK_indexed(fs, v, &key);
+      break;
+    case '.':
+      fieldsel(ls, v);
+      break;
+    default:
+      luaX_syntaxerror(ls, "expected '.' or '[' after '?'");
+  }
+  luaK_exp2nextreg(fs, v);
+  if (v->u.info != base)
+    luaK_codeABC(fs, OP_MOVE, base, v->u.info, 0);
+  fs->freereg = cast_byte(base + 1);
+  init_exp(v, VNONRELOC, base);
+  luaK_patchtohere(fs, jump);
+}
