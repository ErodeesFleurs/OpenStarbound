+/*
+** Read a compound assignment with the normal binary-operator code
+** generator, including metamethods. Keep the indexed lvalue's registers
+** live while loading its old value and evaluating the right-hand side.
+*/
+static void compound_assign_op (LexState *ls, expdesc *var) {
+  static const BinOpr operators[] = {
+    OPR_ADD, OPR_SUB, OPR_MUL, OPR_MOD, OPR_DIV, OPR_IDIV,
+    OPR_CONCAT, OPR_SHL, OPR_SHR, OPR_BAND, OPR_BOR
+  };
+  FuncState *fs = ls->fs;
+  BinOpr op = operators[ls->t.token - TK_SCPLUS];
+  int line = ls->linenumber;
+  expdesc value, rhs;
+  check_condition(ls, vkisvar(var->k), "syntax error");
+  check_readonly(ls, var);
+  value = *var;
+  if (vkisindexed(var->k)) {
+    int live = fs->freereg;
+    luaK_dischargevars(fs, &value);
+    /* Loading a field normally releases its receiver/key registers. They
+       remain the destination of this assignment, so keep them live. */
+    fs->freereg = cast_byte(live);
+  }
+  luaK_exp2nextreg(fs, &value);
+  luaX_next(ls);  /* skip the compound operator */
+  enterlevel(ls);
+  luaK_infix(fs, op, &value);
+  expr(ls, &rhs);
+  luaK_posfix(fs, op, &value, &rhs, line);
+  leavelevel(ls);
+  luaK_storevar(fs, var, &value);
+}
