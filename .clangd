# Regenerate after changing CMake sources or the Nix toolchain (no game build):
# nix develop -c bash scripts/ide/configure-clangd.sh
# clangd needs --experimental-modules-support for importers and --query-driver
# for Nix system headers (with LC_ALL=C, LANGUAGE=C); see .zed/settings.json.
CompileFlags:
  CompilationDatabase: build/clangd
  # GCC's module mapper and BMI flags are not understood by Clang.
  Remove: [-fmodules-ts, -fmodule-mapper=*, -fmodule-only, -fdeps-*]

---
If:
  PathMatch: .*\.cppm
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c++20, -xc++]
