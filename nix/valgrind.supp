# Valgrind suppressions for the test binaries.
#
# RE2's optimizer produces known undefined-value reports. Keep those
# suppressions scoped to RE2 at the innermost frame.
# Static libc++ requires allocator interception in the main executable:
# --soname-synonyms=somalloc=NONE prevents false new/delete mismatch reports
# without disabling allocation-family or memory-access checks.
#
#   valgrind --soname-synonyms=somalloc=NONE --suppressions=nix/valgrind.supp --track-origins=yes \
#     ./dist/game_tests -bootconfig <cfg> --gtest_filter='<cases>'
#
# Regenerate (or extend, if a report inside re2 shows a different error kind)
# with:
#   valgrind --soname-synonyms=somalloc=NONE --gen-suppressions=all ./dist/game_tests -bootconfig <cfg> --gtest_filter='<cases>'
#
# 'fun:' patterns are mangled symbol names; '*' is a wildcard and a trailing
# '...' matches the rest of the stack.

{
   re2-conditional-jump
   Memcheck:Cond
   fun:_ZN3re2*
   ...
}

{
   re2-use-of-uninitialised-value-8
   Memcheck:Value8
   fun:_ZN3re2*
   ...
}

{
   re2-use-of-uninitialised-value-4
   Memcheck:Value4
   fun:_ZN3re2*
   ...
}

{
   re2-use-of-uninitialised-value-2
   Memcheck:Value2
   fun:_ZN3re2*
   ...
}

{
   re2-use-of-uninitialised-value-1
   Memcheck:Value1
   fun:_ZN3re2*
   ...
}

# libunwind probes whether stack addresses are readable by calling write() on
# them; valgrind reports the probe itself.  It shows up whenever cpptrace takes a
# stack trace for an exception (StarException_unix.cpp).
{
   libunwind-address-probe
   Memcheck:Param
   write(buf)
   fun:syscall
   fun:_UIx86_64_address_is_valid
   ...
}

