# Adapt an unpacked xclang tree to the native Ubuntu C SDK. Run independently:
# cmake -DXCLANG_ROOT=<tree> -P <this-file>
# Only the host Linux target changes; other targets retain their bundled SDKs.
cmake_minimum_required(VERSION 3.28)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "The native Linux SDK requires a Linux host")
endif()
if(NOT XCLANG_ROOT)
    message(FATAL_ERROR "Set XCLANG_ROOT to the unpacked xclang tree")
endif()
cmake_path(ABSOLUTE_PATH XCLANG_ROOT NORMALIZE)
cmake_host_system_information(RESULT native_arch QUERY OS_PLATFORM)
if(native_arch MATCHES "^(arm64|aarch64|ARM64)$")
    set(native_arch aarch64)
    set(native_loader "lib/ld-linux-aarch64.so.1")
elseif(native_arch STREQUAL "x86_64")
    set(native_loader "lib64/ld-linux-x86-64.so.2")
else()
    message(FATAL_ERROR "Unsupported native Linux architecture: ${native_arch}")
endif()
set(native_target "${native_arch}-unknown-linux-gnu")
set(native_multiarch "${native_arch}-linux-gnu")
set(bundled_runtime "${XCLANG_ROOT}/${native_target}/usr")
set(native_runtime "${XCLANG_ROOT}/native-runtime/${native_target}")

# Require one complete Debian/Ubuntu SDK, not just a host include directory.
# Record C SDK inputs in the driver config so vcpkg's additional-file hash
# invalidates its ABI cache when the runner's glibc/startup files change.
set(sdk_identity "")
foreach(sdk_file
        "usr/include/features.h"
        "usr/include/${native_multiarch}/bits/libc-header-start.h"
        "usr/lib/${native_multiarch}/libc.so"
        "lib/${native_multiarch}/libc.so.6"
        "usr/lib/${native_multiarch}/crt1.o"
        "usr/lib/${native_multiarch}/Scrt1.o"
        "usr/lib/${native_multiarch}/crti.o"
        "usr/lib/${native_multiarch}/crtn.o"
        "${native_loader}")
    set(sdk_path "/${sdk_file}")
    if(NOT EXISTS "${sdk_path}")
        message(FATAL_ERROR "Incomplete native Ubuntu SDK: missing ${sdk_path}")
    endif()
    file(SHA256 "${sdk_path}" sdk_hash)
    string(APPEND sdk_identity "# ${sdk_file}: ${sdk_hash}\n")
endforeach()

# Never add the old sysroot's library directories: they also contain glibc.
# Expose only the bundled C++ runtime and its module metadata. -B lets driver
# queries (including CMake's import-std discovery) find libc++.modules.json;
# -L supplies the same static archives to the linker. Neither directory has
# libc, libm, a dynamic loader, or C startup files.
file(MAKE_DIRECTORY "${native_runtime}/lib" "${native_runtime}/share")
foreach(runtime_file libc++.a libc++abi.a libunwind.a libc++experimental.a libc++.modules.json)
    if(NOT EXISTS "${bundled_runtime}/lib/${runtime_file}")
        message(FATAL_ERROR "Incomplete xclang C++ runtime: ${runtime_file}")
    endif()
    file(CREATE_LINK "../../../${native_target}/usr/lib/${runtime_file}"
        "${native_runtime}/lib/${runtime_file}" SYMBOLIC)
endforeach()
file(CREATE_LINK "../../../${native_target}/usr/share/libc++"
    "${native_runtime}/share/libc++" SYMBOLIC)

set(native_config [=[# OpenStarbound native Linux C SDK; generated by configure-native-linux-sdk.cmake.
# This target requires the build host's glibc, not the bundled glibc 2.17 baseline.
@sdk_identity@--sysroot=/
-stdlib++-isystem <CFGDIR>/../libc++/include/@native_target@/c++/v1
-stdlib++-isystem <CFGDIR>/../libc++/include/c++/v1
-B<CFGDIR>/../native-runtime/@native_target@/lib/
-L<CFGDIR>/../native-runtime/@native_target@/lib
-rtlib=compiler-rt
-unwindlib=libunwind
-stdlib=libc++
-static-libstdc++
-static-libgcc
-fuse-ld=lld
]=])
string(CONFIGURE "${native_config}" native_config @ONLY)
# Clang accepts both vendor spellings. Use identical configurations even if
# the release uses separate files rather than symlinks for these aliases.
foreach(native_vendor unknown pc)
    file(WRITE "${XCLANG_ROOT}/bin/${native_arch}-${native_vendor}-linux-gnu.cfg" "${native_config}")
endforeach()
message(STATUS "xclang ${native_target}: host C SDK /, bundled static C++ runtime")
