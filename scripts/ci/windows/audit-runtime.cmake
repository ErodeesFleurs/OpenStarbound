# CI runs this after copying the C-ABI SDK/SDL DLLs, before packaging.
cmake_minimum_required(VERSION 3.28)
if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "The Windows runtime gate must run on Windows")
endif()
get_filename_component(dist "${CMAKE_CURRENT_LIST_DIR}/../../../dist" ABSOLUTE)
set(objdump "$ENV{XCLANG_ROOT}/bin/llvm-objdump.exe")
if(NOT EXISTS "${objdump}")
    message(FATAL_ERROR "Set XCLANG_ROOT to the pinned xclang installation")
endif()
foreach(program starbound starbound_server btree_repacker asset_packer json_tool mod_uploader)
    if(NOT EXISTS "${dist}/${program}.exe")
        message(FATAL_ERROR "Missing Windows product: ${program}.exe")
    endif()
endforeach()
file(GLOB binaries "${dist}/*.exe" "${dist}/*.dll")
foreach(binary IN LISTS binaries)
    get_filename_component(name "${binary}" NAME)
    execute_process(COMMAND "${objdump}" -p "${binary}"
        OUTPUT_VARIABLE imports ERROR_VARIABLE error RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${name}: ${error}")
    endif()
    string(REGEX MATCHALL "DLL Name: [^\r\n]+" dll_lines "${imports}")
    foreach(line IN LISTS dll_lines)
        string(REPLACE "DLL Name: " "" dll "${line}")
        string(STRIP "${dll}" dll)
        string(TOLOWER "${dll}" lower_dll)
        set(os_dll FALSE)
        if(lower_dll MATCHES "^(api-ms-win-|ext-ms-win-)" OR EXISTS "$ENV{SystemRoot}/System32/${dll}")
            set(os_dll TRUE)
        endif()
        # A runner's installed VC redistributable is not an OS dependency.
        if(lower_dll MATCHES "^(msvcp[0-9]|msvcr[0-9]|vcruntime[0-9])")
            set(os_dll FALSE)
        endif()
        if(os_dll)
            continue()
        endif()
        # These are the only executables in the DLL-free server distribution.
        if(name STREQUAL "starbound_server.exe" OR name STREQUAL "btree_repacker.exe")
            message(FATAL_ERROR "Server distribution cannot load non-OS DLL ${dll} imported by ${name}")
        endif()
        if(NOT EXISTS "${dist}/${dll}")
            message(FATAL_ERROR "Unbundled DLL ${dll} imported by ${name}")
        endif()
    endforeach()
    message(STATUS "Audited Windows imports: ${name}")
endforeach()
execute_process(COMMAND "${dist}/starbound_server.exe" -version
    WORKING_DIRECTORY "${dist}"
    OUTPUT_VARIABLE version ERROR_VARIABLE error RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Windows server runtime failed (${status}): ${version}${error}")
endif()
message(STATUS "Windows server runtime: ${version}")
